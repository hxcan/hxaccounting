<?xml version="1.0" encoding="utf-8"?>
<!--
  预算设置页面（v2 自适应窗口算法）
  - 让主人选择预算周期（7/30/90 天 + 自定义）
  - 选择当前账本
  - 保存到 budget_settings 表
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <!-- 标题栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/title_budget_settings"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 当前账本显示 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前账本"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCurrentAccountName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="（未选择）"
                android:textColor="@color/taiji_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 提示文字 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_period_days"
                android:textColor="@color/taiji_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_period_days_hint"
                android:textColor="#888888"
                android:textSize="12sp" />

            <!-- 周期单选组 -->
            <RadioGroup
                android:id="@+id/rgPeriodDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbPeriod7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/period_7_days"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbPeriod30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:checked="true"
                    android:text="@string/period_30_days"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbPeriod90"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/period_90_days"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbPeriodCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/period_custom"
                    android:textSize="14sp" />

            </RadioGroup>

            <!-- 自定义输入（默认隐藏） -->
            <EditText
                android:id="@+id/etCustomPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_custom_period"
                android:inputType="number"
                android:visibility="gone"
                android:autofillHints="" />

            <!-- 保存按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/btn_save" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
